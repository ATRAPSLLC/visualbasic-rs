VERSION 5.00
Begin VB.PropertyPage KnobPage 
   Caption         =   "Knob"
   ClientHeight    =   1500
   ClientLeft      =   0
   ClientTop       =   0
   ClientWidth     =   3000
   PaletteMode     =   0  'Halftone
   ScaleHeight     =   1500
   ScaleWidth      =   3000
   Begin VB.TextBox PositionText 
      Height          =   375
      Left            =   120
      TabIndex        =   0
      Text            =   "0"
      Top             =   120
      Width           =   1215
   End
End
Attribute VB_Name = "KnobPage"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Option Explicit

' Knob's property page: reads and writes the selected controls, marks
' itself changed, calls its own built-in members.

Private m_Loads As Long

Private Sub PropertyPage_SelectionChanged()
    m_Loads = m_Loads + 1
    PositionText.Text = CStr(SelectedControls(0).Position)
    Changed = False
End Sub

Private Sub PropertyPage_ApplyChanges()
    Dim k As Object
    For Each k In SelectedControls
        k.Position = Val(PositionText.Text)
    Next
End Sub

Private Sub PositionText_Change()
    Changed = True
    PropertyPage.Caption = "Knob " & m_Loads
End Sub

Public Function Loads() As Long
    Loads = m_Loads
End Function
